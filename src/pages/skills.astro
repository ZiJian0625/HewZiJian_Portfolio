---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Skills">
  <div class="skills-header">
    <h1 class="page-title">My <span class="highlight">Skills</span></h1>
    <p class="page-subtitle">Tools and technologies I work with.</p>
  </div>

  <div class="skills-container">
    
    <div class="skill-category glass-panel">
      <h2>Languages</h2>
      <div class="skill-grid">
        <div class="skill-item">Dart</div>
        <div class="skill-item">Python</div>
        <div class="skill-item">C</div>
        <div class="skill-item">SQL</div>
        <div class="skill-item">HTML & CSS</div>
        <div class="skill-item">JavaScript</div>
        <div class="skill-item">Java</div>
      </div>
    </div>

    <div class="skill-category glass-panel">
      <h2>Frameworks & Cloud</h2>
      <div class="skill-grid">
        <div class="skill-item">Flutter</div>
        <div class="skill-item">AWS (EC2, S3, ASG)</div>
        <div class="skill-item">Firebase</div>
      </div>
    </div>

    <div class="skill-category glass-panel">
      <h2>Databases</h2>
      <div class="skill-grid">
        <div class="skill-item">Firestore</div>
        <div class="skill-item">MySQL</div>
        <div class="skill-item">SQL Server</div>
      </div>
    </div>

    <div class="skill-category glass-panel">
      <h2>Tools & IDEs</h2>
      <div class="skill-grid">
        <div class="skill-item">VS Code</div>
        <div class="skill-item">Android Studio</div>
        <div class="skill-item">Antigravity IDE</div>
        <div class="skill-item">SSMS</div>
        <div class="skill-item">Jupyter Notebook</div>
        <div class="skill-item">Git / GitHub</div>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .skills-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .page-title {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .highlight {
    color: var(--accent);
  }

  .skills-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .skills-container {
      grid-template-columns: 1fr;
    }
  }

  .skill-category {
    padding: 2rem;
  }

  .skill-category h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }

  .skill-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    padding: 0.8rem 1rem;
    border-radius: 8px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .skill-item:hover {
    background: var(--accent-glow);
    border-color: var(--accent);
    color: var(--text-main);
    transform: translateY(-2px);
  }
</style>
