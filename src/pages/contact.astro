<style>
  .contact-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .page-title {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .highlight {
    color: var(--accent);
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-info {
    padding: 2.5rem;
    width: 100%;
  }

  .contact-info h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .contact-info p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
    text-align: center;
  }

  .social-contact-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .social-contact-card {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.2rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-contact-card:hover {
    background: var(--accent-glow);
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--bg-main);
    color: var(--text-main);
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
  }

  .social-details {
    display: flex;
    flex-direction: column;
  }

  .social-details h3 {
    font-size: 1.05rem;
    font-family: var(--font-body);
    color: var(--text-main);
    font-weight: 600;
    margin-bottom: 0.1rem;
    line-height: 1.2;
  }

  .social-details span {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>
