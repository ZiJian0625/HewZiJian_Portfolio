---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <div class="about-header">
    <h1 class="page-title">About <span class="highlight">Me</span></h1>
    <p class="page-subtitle">My academic journey and professional experiences.</p>
  </div>

  <div class="about-grid">
    <section class="timeline-section">
      <div class="timeline-controls">
        <button id="sort-timeline-btn" class="sort-btn" data-order="desc">
          ↓ Latest first
        </button>
      </div>
      <div class="timeline" id="timeline-container">
        
        <!-- Timeline Item 1 -->
        <div class="timeline-item glass-panel">
          <div class="timeline-dot"></div>
          <div class="timeline-header">
            <div class="timeline-date">Jan 2026 - July 2026</div>
            <span class="tag tag-work">WORK</span>
          </div>
          <div class="timeline-content">
            <h3>Software Programmer Executive (Internship)</h3>
            <h4>Ideo Soft Sdn Bhd</h4>
            <p>
              Managed database migrations, network configurations, and software compliance within the 
              AutoCount enterprise ecosystem. Optimized SQL Server databases for 20+ corporate clients, 
              implemented LHDN MyTax e-invoicing integrations, and configured C# data outputs and 
              secure multi-node VPN networks.
            </p>
          </div>
        </div>

        <!-- Timeline Item 2 -->
        <div class="timeline-item glass-panel">
          <div class="timeline-dot"></div>
          <div class="timeline-header">
            <div class="timeline-date">July 2024 - July 2026</div>
            <span class="tag tag-edu">EDUCATION</span>
          </div>
          <div class="timeline-content">
            <h3>Bachelor of Software Engineering (Hons)</h3>
            <h4>Tunku Abdul Rahman University of Management and Technology (TARUMT)</h4>
            <div class="cgpa">CGPA: 3.81</div>
            <p>
              Exploring software architecture, Python backends, and mobile engineering to build clean, 
              scalable digital products.
            </p>
          </div>
        </div>

        <!-- Timeline Item 3 -->
        <div class="timeline-item glass-panel">
          <div class="timeline-dot"></div>
          <div class="timeline-header">
            <div class="timeline-date">Nov 2023 - Jan 2024</div>
            <span class="tag tag-work">WORK</span>
          </div>
          <div class="timeline-content">
            <h3>Technical Assistant (Internship)</h3>
            <h4>Jurudata Services Sdn Bhd</h4>
            <p>
              Managed and deployed in-house self check-in/out kiosk systems for 10+ hospitality clients. 
              Executed pre-deployment software QA, configured PC hardware and network setups on-site, 
              and verified integrations for peripheral devices such as passport scanners.
            </p>
          </div>
        </div>

        <!-- Timeline Item 4 -->
        <div class="timeline-item glass-panel">
          <div class="timeline-dot"></div>
          <div class="timeline-header">
            <div class="timeline-date">July 2022 - July 2024</div>
            <span class="tag tag-edu">EDUCATION</span>
          </div>
          <div class="timeline-content">
            <h3>Diploma in Information Technology</h3>
            <h4>Tunku Abdul Rahman University of Management and Technology (TARUMT)</h4>
            <div class="cgpa">CGPA: 3.63</div>
            <p>
              Built a solid foundation in IT and programming fundamentals, algorithms, and software design.
            </p>
          </div>
        </div>
        
      </div>
    </section>

    <aside class="about-sidebar glass-panel">
      <div class="sidebar-header">
        <h2>Outside the IDE</h2>
        <p>I'm naturally a quiet person who enjoys a calm routine, Off the clock, I recharge on the 
        badminton court, immersed in open-world games, and through continuous learning.</p>
      </div>

      <div class="bento-grid">
        <div class="bento-card">
          <div class="bento-icon">🔥</div>
          <h3>Spicy Food</h3>
          <p>Always on the hunt for bold, spicy flavors and trying out local fast food spots.</p>
        </div>
        
        <div class="bento-card">
          <div class="bento-icon">🎮</div>
          <h3>Games</h3>
          <p>Competing on the Rift in League of Legends, cruising Mexico in Forza Horizon 5, 
          and exploring open worlds in RDR2.</p>
        </div>

        <div class="bento-card">
          <div class="bento-icon">🏸</div>
          <h3>Badminton</h3>
          <p>Active doubles player — hitting the court to blow off steam, stay sharp, 
          and chase that post-match dopamine.</p>
        </div>

        <div class="bento-card">
          <div class="bento-icon">🤖</div>
          <h3>AI & Productivity</h3>
          <p>Big fan of modern AI tools like Claude — always curious about how technology 
          can streamline work and boost everyday creativity.</p>
        </div>
      </div>

      <div class="sidebar-stats">
        <div class="stat-item">
          <strong>4</strong>
          <span>years in tech</span>
        </div>
        <div class="stat-item">
          <strong>10+</strong>
          <span>projects shipped</span>
        </div>
        <div class="stat-item">
          <strong>4</strong>
          <span>languages spoken</span>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .about-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .page-title {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .highlight {
    color: var(--accent);
  }

  /* Layout Grid */
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    align-items: start;
    padding-bottom: 2rem;
  }

  /* Timeline */
  .timeline-section {
    position: relative;
    padding: 0;
  }

  .timeline {
    position: relative;
    padding-left: 3rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 11px;
    height: 100%;
    width: 2px;
    background: var(--border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    padding: 2rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .timeline-item:hover {
    transform: translateX(10px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .timeline-dot {
    position: absolute;
    top: 2rem;
    left: -3rem; /* Align with the line */
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg-main);
    border: 4px solid var(--accent);
    transform: translateX(-4px); /* Fine tune alignment */
    z-index: 2;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .timeline-date {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 1px;
  }

  .tag {
    padding: 0.2rem 0.8rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .tag-edu {
    background-color: #e0f2fe;
    color: #0284c7;
  }

  .tag-work {
    background-color: #f3e8ff;
    color: #9333ea;
  }

  :global([data-theme="dark"]) .tag-edu {
    background-color: rgba(8, 47, 73, 0.5);
    color: #7dd3fc;
  }

  :global([data-theme="dark"]) .tag-work {
    background-color: rgba(59, 7, 100, 0.5);
    color: #d8b4fe;
  }

  .cgpa {
    font-size: 0.85rem;
    color: var(--text-secondary);
    opacity: 0.8;
    margin-top: -0.5rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .timeline-content h3 {
    font-size: 1.4rem;
    margin-bottom: 0.25rem;
  }

  .timeline-content h4 {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .timeline-content p {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  /* Sidebar Panel */
  .about-sidebar {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 2rem;
  }

  .sidebar-header h2 {
    font-size: 1.8rem;
    margin-bottom: 0.8rem;
    font-family: var(--font-heading);
  }

  .sidebar-header p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .bento-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.2rem;
    text-align: center;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .bento-card:hover {
    background: var(--accent-glow);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .bento-icon {
    font-size: 2rem;
    background: var(--bg-main);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin-bottom: 0.5rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .bento-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .bento-card p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .sidebar-stats {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border);
    margin-top: 0.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
  }

  .stat-item strong {
    font-size: 1.5rem;
    color: var(--accent);
    font-family: var(--font-heading);
  }

  .stat-item span {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    max-width: 80px;
    line-height: 1.3;
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-sidebar {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .timeline {
      padding-left: 2rem;
    }
    .timeline::before {
      left: 7px;
    }
    .timeline-dot {
      left: -2rem;
      transform: translateX(-2px);
    }
    .timeline-item {
      padding: 1.5rem;
    }
    .timeline-controls {
      padding-left: 2rem;
    }
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .sidebar-stats {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
  .timeline-controls {
    margin-bottom: 2rem;
    display: flex;
    justify-content: flex-start;
    padding-left: 3rem;
  }

  .sort-btn {
    padding: 0.6rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-main);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
  }

  .sort-btn:hover {
    background: var(--glass-bg);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
</style>

<script>
  function setupTimelineSort() {
    const btn = document.getElementById('sort-timeline-btn');
    const container = document.getElementById('timeline-container');
    
    if (!btn || !container) return;

    // We only attach the event listener if it hasn't been attached yet
    if (btn.hasAttribute('data-initialized')) return;
    btn.setAttribute('data-initialized', 'true');

    btn.addEventListener('click', () => {
      const isDesc = btn.getAttribute('data-order') === 'desc';
      
      // Toggle order attribute
      btn.setAttribute('data-order', isDesc ? 'asc' : 'desc');
      
      // Update button text
      btn.innerHTML = isDesc ? '↑ Earliest first' : '↓ Latest first';
      
      // Reverse elements
      const items = Array.from(container.querySelectorAll('.timeline-item'));
      items.reverse().forEach(item => container.appendChild(item));
    });
  }

  document.addEventListener('astro:page-load', setupTimelineSort);
</script>
