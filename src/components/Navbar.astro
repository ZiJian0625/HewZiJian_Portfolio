---
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, ""); // remove trailing slash if any
---
<div class="navbar-wrapper">
  <nav class="navbar glass-panel">
    <a href="/" class="logo">HJ<span>.</span></a>
    
    <div class="nav-links" id="nav-links">
      <a href="/" class={currentPath === "" ? "active" : ""}>Home</a>
      <a href="/about" class={currentPath === "/about" ? "active" : ""}>About</a>
      <a href="/projects" class={currentPath.startsWith("/projects") ? "active" : ""}>Projects</a>
      <a href="/skills" class={currentPath === "/skills" ? "active" : ""}>Skills</a>
      <a href="/contact" class={currentPath === "/contact" ? "active" : ""}>Contact</a>
    </div>

    <div class="nav-actions">
      <ThemeToggle />
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>
</div>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 1.5rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 100;
    padding: 0 1rem;
    pointer-events: none;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 900px;
    padding: 0.8rem 1.5rem;
    border-radius: 50px;
    pointer-events: auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    position: relative; /* For mobile menu absolute positioning */
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
  }

  .logo span {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
  }

  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    transition: background 0.3s, color 0.3s;
    color: var(--text-secondary);
    text-align: center;
  }

  .nav-links a:hover {
    color: var(--text-main);
    background: rgba(0, 0, 0, 0.05);
  }

  :global([data-theme="dark"]) .nav-links a:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-links a.active {
    background: var(--text-main);
    color: var(--bg-main);
  }

  :global([data-theme="dark"]) .nav-links a.active {
    background: var(--accent);
    color: #fff;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-main);
    cursor: pointer;
    padding: 0.5rem;
  }

  @media (max-width: 768px) {
    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin-top: 1rem;
      flex-direction: column;
      background: var(--bg-secondary);
      padding: 1.5rem;
      border-radius: 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      border: 1px solid var(--border);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all 0.3s ease;
      pointer-events: none;
    }

    .nav-links.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }
    
    .nav-links a {
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const navLinks = document.getElementById('nav-links');
    
    if (mobileBtn && navLinks) {
      mobileBtn.addEventListener('click', () => {
        navLinks.classList.toggle('show');
      });
    }
  }
  
  // Setup on initial load
  setupMobileMenu();
  
  // Setup after view transitions
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
