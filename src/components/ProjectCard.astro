---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, shortDescription, icon, image, techStack } = project.data;
---

<a href={`/projects/${project.id}`} class="project-card glass-panel">
  {image ? (
    <div class="card-image-wrapper">
      <img src={image} alt={title} class="card-image" />
    </div>
  ) : (
    <div class="card-icon">{icon || '📁'}</div>
  )}
  <h2 class="card-title">{title}</h2>
  <p class="card-desc">{shortDescription}</p>
  
  <div class="tech-stack">
    {techStack.map((tech) => (
      <span class="tech-badge">{tech}</span>
    ))}
  </div>
</a>

<style>
  .project-card {
    display: block;
    padding: 2rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
    height: 100%;
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
  }

  .card-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .card-image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 140px;
    margin-bottom: 1.5rem;
    padding: 0.5rem;
  }

  .card-image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 8px; /* Slight rounding for square images */
  }

  .card-title {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .card-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-badge {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .project-card:hover .tech-badge {
    border-color: rgba(59, 130, 246, 0.3);
    color: var(--text-main);
  }
</style>
